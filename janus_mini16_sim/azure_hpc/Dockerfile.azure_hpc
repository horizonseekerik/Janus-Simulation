# ==============================================================================
# PROJECT JANUS MINI (16-TILE): AZURE HPC CLUSTER DOCKER CONTAINER
# ==============================================================================
# Base Image: Ubuntu 22.04 LTS with OpenMPI and InfiniBand runtime
FROM ubuntu:22.04

LABEL maintainer="Project Janus Core Architecture Team"
LABEL description="Azure HPC Container for Project Janus Multi-Physics Simulation (Meep MPI, Elmer FEM, Xyce, Python 3.12)"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install system dependencies, compilers, and MPI libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gfortran \
    cmake \
    git \
    wget \
    curl \
    ca-certificates \
    libopenmpi-dev \
    openmpi-bin \
    libblas-dev \
    liblapack-dev \
    libhdf5-openmpi-dev \
    libfftw3-dev \
    gmsh \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Set up Python virtual environment
ENV VIRTUAL_ENV=/opt/janus_env
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install Python scientific stack
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    numpy \
    scipy \
    matplotlib \
    h5py \
    pandas \
    sympy \
    gdsfactory \
    cocotb \
    pytest

# Install conda / mamba for parallel Meep FDTD with MPI
ENV CONDA_DIR=/opt/conda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    /bin/bash /tmp/miniconda.sh -b -p $CONDA_DIR && \
    rm /tmp/miniconda.sh
ENV PATH="$CONDA_DIR/bin:$PATH"

RUN conda create -n pmp -c conda-forge pymeep-parallel python=3.10 -y && \
    conda clean -afy

# Set working directory
WORKDIR /workspace/janus

# Environment entrypoint
CMD ["/bin/bash"]
