{
  "functions": {
    "api/index.py": {
      "includeFiles": "{janus_mini16_sim/**/*.py,janus_mini16_sim/configs/*.json,janus_mini16_sim/orchestrator/artifacts/*.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    }
  ]
}